# OCR API is served from the same Next.js app/origin (e.g. https://conqrocr.com).
# Leaving NEXT_PUBLIC_OCR_API_URL unset makes the frontend call the relative
# path "/api/ocr/extract" on its own origin — no cross-origin request, no CORS,
# and it always hits the deployment that serves the UI (which has a valid
# MISTRAL_API_KEY). Set this only if you intentionally split the OCR backend
# onto a separate, correctly-configured Railway service.
# NEXT_PUBLIC_OCR_API_URL=https://conqrocr-production.up.railway.app
