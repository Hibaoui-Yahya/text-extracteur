{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCRSystemResponse",
  "description": "Strict OCR system response with evidence tracking",
  "type": "object",
  "required": [
    "request_id",
    "plain_text",
    "doc_type",
    "extraction",
    "doc_model",
    "evidence",
    "unmapped_fields",
    "quality",
    "processing_time_ms"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "plain_text": {
      "type": "string",
      "minLength": 1
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "ID_DOCUMENT",
        "CV_RESUME",
        "INVOICE_RECEIPT",
        "CONTRACT_LEGAL",
        "FORM_APPLICATION",
        "CERTIFICATE_DIPLOMA",
        "BANK_STATEMENT",
        "MEDICAL_DOCUMENT",
        "GENERIC_DOCUMENT"
      ]
    },
    "extraction": {
      "type": "object",
      "properties": {
        "document_number": {"type": ["string", "null"]},
        "full_name": {"type": ["string", "null"]},
        "date_of_birth": {"type": ["string", "null"]},
        "date_of_issue": {"type": ["string", "null"]},
        "date_of_expiry": {"type": ["string", "null"]},
        "issuing_authority": {"type": ["string", "null"]},
        "candidate": {
          "type": ["object", "null"],
          "properties": {
            "full_name": {"type": ["string", "null"]},
            "email": {"type": ["string", "null"]},
            "phone": {"type": ["string", "null"]},
            "address": {"type": ["string", "null"]}
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "institution": {"type": ["string", "null"]},
              "degree": {"type": ["string", "null"]},
              "year": {"type": ["string", "null"]}
            }
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "company": {"type": ["string", "null"]},
              "position": {"type": ["string", "null"]},
              "duration": {"type": ["string", "null"]}
            }
          }
        },
        "skills": {"type": ["array", "null"], "items": {"type": "string"}},
        "invoice_number": {"type": ["string", "null"]},
        "date": {"type": ["string", "null"]},
        "vendor": {"type": ["string", "null"]},
        "customer": {"type": ["string", "null"]},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {"type": ["string", "null"]},
              "quantity": {"type": ["number", "null"]},
              "unit_price": {"type": ["number", "null"]},
              "total": {"type": ["number", "null"]}
            }
          }
        },
        "subtotal": {"type": ["number", "null"]},
        "tax": {"type": ["number", "null"]},
        "total": {"type": ["number", "null"]},
        "title": {"type": ["string", "null"]},
        "parties": {"type": ["array", "null"], "items": {"type": "string"}},
        "effective_date": {"type": ["string", "null"]},
        "termination_date": {"type": ["string", "null"]},
        "clauses": {"type": ["array", "null"], "items": {"type": "string"}},
        "form_title": {"type": ["string", "null"]},
        "applicant": {
          "type": ["object", "null"],
          "properties": {
            "name": {"type": ["string", "null"]},
            "address": {"type": ["string", "null"]},
            "contact": {"type": ["string", "null"]}
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {"type": ["string", "null"]},
              "value": {"type": ["string", "null"]}
            }
          }
        },
        "recipient_name": {"type": ["string", "null"]},
        "certificate_title": {"type": ["string", "null"]},
        "issuing_institution": {"type": ["string", "null"]},
        "date_issued": {"type": ["string", "null"]},
        "bank_name": {"type": ["string", "null"]},
        "account_number": {"type": ["string", "null"]},
        "iban": {"type": ["string", "null"]},
        "period": {"type": ["string", "null"]},
        "transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "amount": {"type": ["number", "null"]},
              "balance": {"type": ["number", "null"]}
            }
          }
        },
        "patient_name": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "diagnosis": {"type": ["string", "null"]},
        "treatment": {"type": ["string", "null"]},
        "content": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "doc_model": {
      "type": "object",
      "required": ["pages", "reading_order", "formatting"],
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_number", "elements", "dimensions"],
            "properties": {
              "page_number": {"type": "number"},
              "elements": {"type": "array"},
              "dimensions": {
                "type": "object",
                "required": ["width", "height"],
                "properties": {
                  "width": {"type": "number"},
                  "height": {"type": "number"}
                }
              }
            }
          }
        },
        "reading_order": {"type": "array"},
        "formatting": {
          "type": "object",
          "required": [
            "has_bold",
            "has_italic",
            "has_underline",
            "has_tables",
            "has_lists",
            "multi_column"
          ],
          "properties": {
            "has_bold": {"type": ["boolean", "string"], "enum": [true, false, "unknown"]},
            "has_italic": {"type": ["boolean", "string"], "enum": [true, false, "unknown"]},
            "has_underline": {"type": ["boolean", "string"], "enum": [true, false, "unknown"]},
            "has_tables": {"type": "boolean"},
            "has_lists": {"type": "boolean"},
            "multi_column": {"type": ["boolean", "string"], "enum": [true, false, "unknown"]}
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "value", "source_text", "confidence"],
        "properties": {
          "field": {"type": "string"},
          "value": {},
          "source_text": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "bbox": {
            "type": "object",
            "properties": {
              "x1": {"type": "number"},
              "y1": {"type": "number"},
              "x2": {"type": "number"},
              "y2": {"type": "number"}
            }
          },
          "page": {"type": "number"}
        }
      }
    },
    "unmapped_fields": {
      "type": "array",
      "items": {"type": "string"}
    },
    "quality": {
      "type": "object",
      "required": ["overall_confidence", "needs_review", "warnings"],
      "properties": {
        "overall_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "needs_review": {"type": "boolean"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "processing_time_ms": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}